{
  "name": "total-mail-queue",
  "private": true,
  "description": "Dev tooling for Total Mail Queue (linting only; nothing here ships in the plugin).",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "lint:js": "eslint \"assets/js/**/*.js\"",
